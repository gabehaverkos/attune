# Copy this file to .env and fill in every value. All of them are required, and
# all of them are secrets: .env is never committed. README.md says how to run
# the stack once it is filled in.

# Signs sign-in sessions. Any long random string; make one with
#   openssl rand -base64 32
# Changing it later signs everyone out.
BETTER_AUTH_SECRET=

# The password of the stack's own database. Choose one before the first start:
# the database keeps the password it was created with. Use letters and digits
# only, since it is written into a connection address.
POSTGRES_PASSWORD=

# Every model call goes through OpenRouter. Create a key at
# https://openrouter.ai/keys (it starts with sk-or-), and give the key a spending
# limit there before the site is public.
OPENROUTER_API_KEY=

# Memory's search index is made by Voyage AI. Create a key at
# https://dashboard.voyageai.com (it starts with pa-).
VOYAGE_API_KEY=

# Sends the emails that verify an address or reset a password, from
# verify@attune.haverkos.dev. Create a key at https://resend.com/api-keys (it
# starts with re_) in an account where attune.haverkos.dev is a verified domain.
RESEND_API_KEY=

# Sign in with Google. Create an OAuth client of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add these authorized
# redirect URIs to it:
#   https://attune.haverkos.dev/api/auth/callback/google
#   https://localhost/api/auth/callback/google    (for development)
# The ID ends in .apps.googleusercontent.com; the secret starts with GOCSPX-.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Tracing to Langfuse Cloud. Create a project at https://cloud.langfuse.com (the
# EU region) and copy its API keys from the project's settings: the public key
# starts with pk-lf-, the secret with sk-lf-. Traces record each reply's timing,
# models and cost. On a server they leave out what was said; in development they
# include it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
